# Same Supabase project as KruMath (NEXT_PUBLIC_SUPABASE_* values).
# Required on production for soft-gate helpers (future cloud save / sync).
# Vite embeds VITE_* at build time — rebuild after changing these.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: local KruMath web origin for sign-in / home redirects during development.
# Example: http://localhost:3000
# VITE_KRUMATH_ORIGIN=
